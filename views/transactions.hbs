{{> header}}


<div class="container mt-5">


<h2>
My Transactions
</h2>


<a href="/transactions/add" class="btn btn-primary mb-3">

Add Transaction

</a>



<table class="table table-bordered">


<thead>

<tr>

<th>
Title
</th>

<th>
Amount
</th>

<th>
Type
</th>

<th>
Category
</th>

<th>
Actions
</th>


</tr>

</thead>



<tbody>


{{#each transactions}}


<tr>


<td>
{{this.title}}
</td>


<td>
{{this.amount}}
</td>


<td>
{{this.type}}
</td>


<td>
{{this.category}}
</td>



<td>


<a 
href="/transactions/edit/{{this._id}}"
class="btn btn-warning btn-sm">

Edit

</a>



<a 
href="/transactions/delete/{{this._id}}"
class="btn btn-danger btn-sm"
onclick="return confirm('Delete this transaction?')">

Delete

</a>


</td>


</tr>


{{/each}}



</tbody>


</table>


</div>



{{> footer}}