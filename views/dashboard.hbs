{{> header}}


<div class="container mt-5">


<h1>
Welcome {{user.username}}
</h1>


<p class="lead">
Your financial overview
</p>



<div class="row mt-4">



<div class="col-md-3">


<div class="card text-center">


<div class="card-body">


<h5>
Balance
</h5>


<h3>

{{balance}}

</h3>


</div>


</div>


</div>





<div class="col-md-3">


<div class="card text-center">


<div class="card-body">


<h5>
Income
</h5>


<h3>

{{income}}

</h3>


</div>


</div>


</div>






<div class="col-md-3">


<div class="card text-center">


<div class="card-body">


<h5>
Expenses
</h5>


<h3>

{{expenses}}

</h3>


</div>


</div>


</div>






<div class="col-md-3">


<div class="card text-center">


<div class="card-body">


<h5>
Transactions
</h5>


<h3>

{{totalTransactions}}

</h3>


</div>


</div>


</div>



</div>





<hr class="mt-5">



<a href="/transactions"

class="btn btn-primary">

Manage Transactions

</a>




<a href="/transactions/add"

class="btn btn-success">

Add Transaction

</a>





<h3 class="mt-5">
Recent Transactions
</h3>




<table class="table table-striped">


<thead>

<tr>

<th>
Title
</th>


<th>
Amount
</th>


<th>
Type
</th>


<th>
Category
</th>


</tr>

</thead>




<tbody>



{{#each transactions}}



<tr>


<td>

{{this.title}}

</td>



<td>

{{this.amount}}

</td>



<td>

{{this.type}}

</td>



<td>

{{this.category}}

</td>



</tr>




{{else}}



<tr>

<td colspan="4">

No transactions yet.

</td>

</tr>



{{/each}}



</tbody>


</table>




</div>


{{> footer}}