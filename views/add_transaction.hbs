{{> header}}


<div class="container mt-5">


<h2>
Add Transaction
</h2>



<form method="POST" action="/transactions/add">



<div class="mb-3">

<label>
Transaction Title
</label>


<input

type="text"

name="title"

class="form-control"

placeholder="Example: Salary, Food, Rent"

required>


</div>





<div class="mb-3">

<label>
Amount
</label>


<input

type="number"

name="amount"

class="form-control"

required>


</div>





<div class="mb-3">

<label>
Transaction Type
</label>


<select

name="type"

class="form-control">


<option value="income">
Income
</option>


<option value="expense">
Expense
</option>


</select>


</div>





<div class="mb-3">

<label>
Category
</label>


<input

type="text"

name="category"

class="form-control"

placeholder="Food, Transport, Salary"

required>


</div>





<div class="mb-3">

<label>
Date
</label>


<input

type="date"

name="date"

class="form-control">


</div>





<button class="btn btn-primary">

Save Transaction

</button>


</form>



</div>



{{> footer}}